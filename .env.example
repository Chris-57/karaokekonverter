# Optional advanced overrides. Prefer YouTube connection on the local website.
# A YouTube key saved in local settings takes priority over YOUTUBE_API_KEY here.
# Never include real credentials in source control. This file is not required.
YOUTUBE_API_KEY=
# The AWS demo uses this code; local startup creates its own automatic session.
APP_ACCESS_CODE=
PORT=3000
# Choose browser to recover the original public-page approach, or api if you have SoundCloud app credentials.
SOUNDCLOUD_MODE=browser
# Chrome/Edge is detected automatically. Set a path only for an unusual install.
CHROME_EXECUTABLE_PATH=
# false preserves the visible browser mode verified with the local Spotify probe.
SPOTIFY_HEADLESS=false
# Required only for SoundCloud API mode. Keep these server-side.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
MAX_TRACKS=20
